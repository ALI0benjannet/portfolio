# Copiez ce fichier en .env.local et remplissez les valeurs.
# Gmail : utilisez un « mot de passe d'application » de 16 caractères, sans espaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM='"Portfolio Contact" <you@gmail.com>'
TO_EMAIL=you@gmail.com
